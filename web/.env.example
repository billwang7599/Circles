# Backend only. Never ship these in the web app. Copy to .env.
# Bedrock, with credentials from the AWS chain. Leave BEDROCK_MODEL_ID unset to run on the fake model.
# e.g. us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=
AWS_PROFILE=circles
AWS_REGION=ca-central-1

# Google Places API (New). Leave the key unset to run on fake restaurants.
GOOGLE_PLACES_API_KEY=
# Hard cap on live Google requests per server run (default 30). Leave blank for the default.
GOOGLE_PLACES_MAX_REQUESTS=

# Web search on Amazon Bedrock AgentCore: the GatewayUrl output of the circles-web-search stack (us-east-1).
# Leave unset to run on fake web results. Costs $7 per 1,000 searches, at most 5 per plan.
AGENTCORE_GATEWAY_URL=
