PORT=3001
# Where invite links point; this host when unset.
PUBLIC_URL=
# Where an invitee can get the app; the invite page skips the button when unset.
APP_STORE_URL=
# The Apple team the iOS app is signed with; iOS opens invite links in the app once set.
APPLE_TEAM_ID=
DATABASE_URL=postgres://circles:circles@localhost:5432/circles
AWS_REGION=ca-central-1
AWS_PROFILE=circles
# The model behind event setup, date reading and itineraries; the fakes when unset.
BEDROCK_MODEL_ID=
# With a model set, the venues itineraries name are checked on Amazon Location with the same credentials; otherwise a fake that knows only resorts, parks and markets.
# Map lookups each API process may make; venues past the cap are dropped.
PLACES_MAX_REQUESTS=300
# Where the group usually is, longitude,latitude, which venue searches lean towards; Toronto when unset.
PLACES_BIAS=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
